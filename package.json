{
  "name": "world-cup-simulation",
  "type": "module",
  "version": "0.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
