---
import TeamsIndex from "../../../components/content/TeamsIndex.astro";
import { locales } from "../../../i18n/config";

export function getStaticPaths() {
  const paths = [];
  for (const l of locales) {
    if (l === "en") continue;
    paths.push({ params: { lang: l } });
  }
  return paths;
}

const { lang } = Astro.params;
---

<TeamsIndex lang={lang} path="/teams" />
