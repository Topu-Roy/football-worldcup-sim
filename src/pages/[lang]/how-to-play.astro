---
import HowToPlay from "../../components/content/HowToPlay.astro";
import { locales } from "../../i18n/config";

export function getStaticPaths() {
  const paths = [];
  for (const l of locales) {
    if (l === "en") continue;
    paths.push({ params: { lang: l } });
  }
  return paths;
}

const { lang } = Astro.params;
---

<HowToPlay lang={lang} path="/how-to-play" />
