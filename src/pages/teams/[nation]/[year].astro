---
import TeamDetail from "../../../components/content/TeamDetail.astro";
import { HISTORICAL_SQUADS } from "../../../data/historical/index";
import { playerRating } from "../../../lib/draft/rating";
import { FORMATIONS } from "../../../lib/types";

export function getStaticPaths() {
  const paths = [];
  for (const s of HISTORICAL_SQUADS) {
    const slug = s.nation.toLowerCase();
    const year = String(s.wcYear);
    const ratings = s.players.map((p) => playerRating(p));
    const avg = Math.round(ratings.reduce((a, b) => a + b, 0) / ratings.length);
    let top = s.players[0];
    for (const p of s.players) {
      if (playerRating(p) > playerRating(top)) top = p;
    }
    const display = s.name.replace(/\s+\d{4}$/, "");
    const formationKeys = Object.keys(FORMATIONS);
    let fl = "4-3-3";
    for (let i = 0; i < formationKeys.length; i++) {
      const k = formationKeys[i];
      const v = FORMATIONS[k];
      if (
        v.GK === s.formation.GK &&
        v.DEF === s.formation.DEF &&
        v.MID === s.formation.MID &&
        v.ATT === s.formation.ATT
      ) {
        fl = k;
        break;
      }
    }
    const players = s.players.map((p) => {
      return {
        name: p.name,
        rating: Math.round(playerRating(p)),
        pos: p.bestPosition,
      };
    });
    const yearList = [];
    for (const o of HISTORICAL_SQUADS) {
      if (o.nation === s.nation && String(o.wcYear) !== year) {
        yearList.push({ year: String(o.wcYear), slug: o.nation.toLowerCase() });
      }
    }
    paths.push({
      params: { nation: slug, year },
      props: {
        nation: display,
        year,
        formationLabel: fl,
        topName: top.name,
        topRating: Math.round(playerRating(top)),
        avgRating: avg,
        players,
        yearList,
      },
    });
  }
  return paths;
}
---

<TeamDetail
  lang="en"
  path={`/teams/${Astro.params.nation}/${Astro.params.year}`}
  {...Astro.props}
/>
