---
import { ArrowRight, Star, Trophy, Users } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import { HISTORICAL_SQUADS } from "../../data/historical/index.js";
import { NATION_NAMES, NATION_SLUGS } from "../../lib/draft.js";
import { playerRating } from "../../lib/draft.js";

const slugOf = (s: (typeof HISTORICAL_SQUADS)[number]) =>
  NATION_SLUGS[s.nation] ?? s.nation.toLowerCase();

const squadStats = HISTORICAL_SQUADS.map((s) => {
  const ratings = s.players.map((p) => playerRating(p));
  const avg = ratings.reduce((a, b) => a + b, 0) / (ratings.length || 1);
  const top = [...s.players].sort(
    (a, b) => playerRating(b) - playerRating(a),
  )[0];
  return { squad: s, avg, top };
});

const byYear = squadStats.reduce<Record<number, typeof squadStats>>(
  (acc, s) => {
    (acc[s.squad.wcYear] ??= []).push(s);
    return acc;
  },
  {},
);

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

const nationName = (s: (typeof HISTORICAL_SQUADS)[number]) =>
  NATION_NAMES[s.nation] ?? s.nation;
---

<Layout
  title="World Cup Teams 1970-2026 — Historical Squads & Player Ratings"
  description={`Browse all ${HISTORICAL_SQUADS.length} historical World Cup teams from 1970 to 2026 with player ratings, from Brazil 1970 to Argentina 2022. Draft any team in the fantasy World Cup simulator.`}
  canonical="/teams/"
>
  <main class="min-h-screen bg-canvas text-white">
    <section
      class="mx-auto max-w-5xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24 sm:pb-16"
    >
      <p
        class="animate-fade font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
      >
        Team index
      </p>
      <h1
        class="animate-fade mt-4 font-display text-5xl leading-[0.9] tracking-[1.07px] sm:text-7xl"
        style="animation-delay: 60ms"
      >
        Every Fantasy Football World Cup team
      </h1>
      <p
        class="animate-fade mt-5 max-w-2xl text-secondary"
        style="animation-delay: 120ms"
      >
        All {HISTORICAL_SQUADS.length} historical World Cup teams from 1970 to 2026,
        ranked by average player rating and ready to draft in the fantasy World Cup
        simulator. This is the squad library behind the whole football simulator.
        The world cup winners, top scorers and best players of five decades are all
        here. They are rated on one scale. So your dream XI and the AI teams are
        fair. Browse any roster — Brazil 1970, France 1998, Germany 2014, Argentina
        2022. Study the player ratings. Then take that into the soccer draft game
        and run your own soccer simulation. It is the easiest way to meet the
        greatest world cup teams before you put them on the pitch. This is a free
        browser soccer game. It is an interactive soccer simulator you play online.
        No download. No sign-up.
      </p>
      <div
        class="animate-fade mt-8 flex flex-wrap items-center gap-3"
        style="animation-delay: 180ms"
      >
        <a
          href="/game"
          class="group inline-flex items-center gap-2 rounded-full bg-mint px-7 py-3.5 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-all duration-200 hover:gap-3 hover:bg-white"
        >
          Play
          <ArrowRight
            class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-5xl space-y-16 px-4 pb-20 sm:px-6 sm:pb-28">
      {
        years.map((year, yi) => (
          <div class:mt-14={yi > 0} class:mt-10={yi === 0}>
            <div class="animate-fade flex items-center gap-3">
              <Trophy class="h-5 w-5 shrink-0 text-mint" />
              <h2 class="font-display text-4xl tracking-[0.5px]">{year}</h2>
              <span class="rounded-full border border-white/15 px-3 py-1 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                {byYear[year].length} teams
              </span>
              <span class="h-px flex-1 bg-linear-to-r from-white/20 to-transparent" />
            </div>

            <ul class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {byYear[year]
                .sort((a, b) =>
                  nationName(a.squad).localeCompare(nationName(b.squad)),
                )
                .map(({ squad: s, avg, top }, i) => (
                  <li
                    class="animate-fade"
                    style={`animation-delay: ${i * 40}ms`}
                  >
                    <a
                      href={`/teams/${slugOf(s)}/${s.wcYear}/`}
                      class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate/40 p-6 transition-all duration-200 hover:-translate-y-1 hover:border-mint/60 hover:shadow-[0_8px_30px_-6px_rgba(60,255,208,0.15)]"
                    >
                      <span class="flex items-start justify-between gap-3">
                        <span class="font-display text-2xl tracking-[0.5px] transition-colors duration-200 group-hover:text-mint">
                          {nationName(s)}
                        </span>
                        <span class="flex shrink-0 items-center gap-1.5 rounded-full border border-mint/30 bg-mint/5 px-2.5 py-1">
                          <Star class="h-3.5 w-3.5 text-mint" />
                          <span class="font-display text-base text-mint">
                            {Math.round(avg)}
                          </span>
                        </span>
                      </span>

                      <span class="mt-5 block h-px w-full bg-linear-to-r from-white/15 via-white/5 to-transparent transition-opacity duration-200 group-hover:opacity-100" />

                      <span class="mt-5 flex items-start gap-2.5 text-sm text-secondary">
                        <Users class="mt-0.5 h-4 w-4 shrink-0 text-mint/70" />
                        <span class="min-w-0">
                          {top && (
                            <span class="block truncate font-semibold text-white transition-colors duration-200 group-hover:text-mint">
                              {top.name}
                            </span>
                          )}
                          <span class="block pt-2 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                            + {s.players.length - 1} others
                          </span>
                        </span>
                      </span>

                      <span class="mt-6 inline-flex items-center gap-1.5 border-t border-white/10 pt-4 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase transition-colors duration-200 group-hover:text-mint">
                        View team
                        <ArrowRight class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
                      </span>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="border-t border-white/10 bg-slate/20">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-16">
        <h2 class="font-display text-2xl tracking-[0.5px] sm:text-3xl">
          Every World Cup squad, ranked and ready to draft
        </h2>
        <div class="mt-5 space-y-4 text-sm leading-relaxed text-secondary">
          <p>
            The World Cup has had many champions since 1930. Each win was built
            on a great squad. This index collects the best teams from 1970 to
            2026. Brazil 1970 is often called the greatest team ever. Argentina
            2022 was Messi's last big run. Every roster is rated player by player.
            So you can compare eras on one scale.
          </p>
          <p>
            Each name is a player you can draft in the soccer simulator. You
            build your own cup with them. This is more than a record book. It is
            the content behind a world cup fantasy game. The world cup winners,
            top scorers and best players of five decades wait for your pick.
          </p>
          <p>
            Want to know the top-rated squad? The cards above rank every team by
            its player ratings. The best player in each side is shown. The squad
            size is shown too. Teams like Spain 2010, Germany 2014 and France 1998
            sit near the top. But rating alone does not win a tournament. Chemistry,
            system and luck matter. That is why a fantasy World Cup simulation is
            fun. A smart world cup dream team builder can beat a higher-rated
            favourite.
          </p>
          <p>
            Each team page lists the full squad. Every player has a rating. You
            can scout the stars and the bench before you build your XI. See how a
            4-3-3 Brazil 1970 compares to a 4-3-3 France 2018. Decide where the
            greatest world cup teams fit on your pitch. Use the index to scout
            rivals. Settle talks about which era was best. Or just relive the
            squads you grew up with.
          </p>
          <p>
            Then take that into the football draft simulator. The app is a free
            browser soccer game. No download. No sign-up. The loop is fast. Read the
            rankings. Open the online soccer game. Draft from every team in World
            Cup history. Build a squad of your own. Pick a formation. Hit Play.
            Take your XI through the full tournament.
          </p>
          <p>
            See if you can beat the legends in this interactive soccer simulator
            and soccer draft game built around the squads on this page.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade {
    animation: fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade {
      animation: none;
    }
  }
</style>
