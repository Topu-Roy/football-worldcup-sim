---
import Layout from "../../layouts/Layout.astro";
import { HISTORICAL_SQUADS } from "../../data/historical/index.js";
import { NATION_NAMES, NATION_SLUGS } from "../../lib/draft.js";
import { playerRating } from "../../lib/draft.js";

const slugOf = (s: (typeof HISTORICAL_SQUADS)[number]) =>
  NATION_SLUGS[s.nation] ?? s.nation.toLowerCase();

const squadStats = HISTORICAL_SQUADS.map((s) => {
  const ratings = s.players.map((p) => playerRating(p));
  const avg = ratings.reduce((a, b) => a + b, 0) / (ratings.length || 1);
  const top = [...s.players].sort((a, b) => playerRating(b) - playerRating(a))[0];
  return { squad: s, avg, top };
});

const featured = [...squadStats].sort((a, b) => b.avg - a.avg).slice(0, 6);

const byYear = [...squadStats]
  .sort((a, b) => a.squad.wcYear - b.squad.wcYear)
  .reduce<Record<number, typeof squadStats>>((acc, s) => {
    (acc[s.squad.wcYear] ??= []).push(s);
    return acc;
  }, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort();

const nationName = (s: (typeof HISTORICAL_SQUADS)[number]) =>
  NATION_NAMES[s.nation] ?? s.nation;
---

<Layout
  title="World Cup Teams 1970-2026 — Historical Squads & Player Ratings"
  description={`Browse all ${HISTORICAL_SQUADS.length} historical World Cup teams from 1970 to 2026 with player ratings, from Brazil 1970 to Argentina 2022. Draft any team in the fantasy World Cup simulator.`}
  canonical="/teams/"
>
  <main class="min-h-screen bg-canvas text-white">
    <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase">
        Team index
      </p>
      <h1 class="mt-4 font-display text-5xl leading-[0.9] tracking-[1.07px] sm:text-7xl">
        Every World Cup team
      </h1>
      <p class="mt-4 max-w-2xl text-secondary">
        All {HISTORICAL_SQUADS.length} historical World Cup teams from 1970 to
        2026, ranked by average player rating. Browse rosters, then draft them
        in the fantasy World Cup simulator.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href="/game"
          class="rounded-full bg-mint px-6 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
        >
          Draft a team
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 sm:px-6">
      <p class="font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase">
        Highest rated
      </p>
      <h2 class="mt-3 font-display text-3xl tracking-[0.5px] sm:text-4xl">
        The legendary squads
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map(({ squad: s, avg, top }) => (
          <li>
            <a
              href={`/teams/${slugOf(s)}/${s.wcYear}/`}
              class="group flex flex-col rounded-2xl border border-white/10 bg-slate/40 p-5 transition-all duration-150 hover:-translate-y-0.5 hover:border-mint hover:bg-slate/60"
            >
              <span class="flex items-start justify-between gap-2">
                <span class="font-display text-2xl tracking-[0.5px]">
                  {nationName(s)}
                  <span class="block text-mint">{s.wcYear}</span>
                </span>
                <span class="text-right">
                  <span class="block font-display text-2xl text-mint">
                    {Math.round(avg)}
                  </span>
                  <span class="block font-mono text-[9px] font-semibold tracking-[1.5px] text-secondary uppercase">
                    Avg rating
                  </span>
                </span>
              </span>
              {top && (
                <span class="mt-4 border-t border-white/10 pt-3 text-xs text-secondary">
                  <span class="font-mono text-[9px] font-semibold tracking-[1.5px] text-secondary uppercase">
                    Star player
                  </span>
                  <span class="mt-0.5 block truncate font-semibold text-white">
                    {top.name}
                  </span>
                </span>
              )}
              <span class="mt-3 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase transition-colors duration-150 group-hover:text-mint">
                {s.players.length} players →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
      {years.map((year) => (
        <div class:mt-12={year !== years[0]} class:mt-8={year === years[0]}>
          <h2 class="font-display text-3xl tracking-[0.5px]">{year}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {byYear[year]
              .sort((a, b) => nationName(a.squad).localeCompare(nationName(b.squad)))
              .map(({ squad: s, avg, top }) => (
                <li>
                  <a
                    href={`/teams/${slugOf(s)}/${s.wcYear}/`}
                    class="group flex items-center justify-between rounded-2xl border border-white/10 bg-slate/40 px-5 py-4 transition-all duration-150 hover:-translate-y-0.5 hover:border-mint hover:bg-slate/60"
                  >
                    <span class="min-w-0">
                      <span class="block font-display text-xl tracking-[0.5px]">
                        {nationName(s)}
                      </span>
                      {top && (
                        <span class="mt-1 block truncate font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                          {top.name} · {Math.round(avg)} avg
                        </span>
                      )}
                    </span>
                    <span class="ml-3 shrink-0 font-mono text-[11px] font-semibold tracking-[1.5px] text-secondary transition-colors duration-150 group-hover:text-mint uppercase">
                      {s.players.length} →
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))}
    </section>
  </main>
</Layout>