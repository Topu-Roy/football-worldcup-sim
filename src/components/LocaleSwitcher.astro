---
import { locales, languages } from "../i18n/config";
import type { Locale } from "../i18n/config";
import { switchLocaleHref } from "../i18n/t";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const path = Astro.url.pathname;
---

<div class="locale-switcher" role="group" aria-label="Language">
  {locales.map((loc) => (
    <a
      href={switchLocaleHref(path, loc)}
      hreflang={loc}
      lang={loc}
      class={`ls-link ${loc === lang ? "is-active" : ""}`}
      aria-current={loc === lang ? "true" : undefined}
    >
      {languages[loc]}
    </a>
  ))}
</div>

<style>
  .locale-switcher {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 8px;
    padding-left: 8px;
    border-left: 1px solid #2d2d2d;
  }

  .ls-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    color: #9a9a9a;
    padding: 4px 6px;
    border-radius: 8px;
    transition: color 150ms ease, background 150ms ease;
  }

  .ls-link:hover {
    color: #3cffd0;
  }

  .ls-link.is-active {
    color: #3cffd0;
    background: rgba(60, 255, 208, 0.12);
  }

  @media (max-width: 549px) {
    .locale-switcher {
      margin-left: 0;
      padding-left: 0;
      border-left: none;
      justify-content: flex-start;
      flex-wrap: wrap;
    }
  }
</style>
