---
import { Picture } from "astro:assets";
import { media, type MediaId } from "../../data/media";
import { mediaCopy } from "../../i18n/content/media";
import type { Locale } from "../../i18n/config";

interface Props {
  id: MediaId;
  lang: Locale;
  variant?: "full" | "grid" | "cover";
  caption?: boolean;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  id,
  lang,
  variant = "full",
  caption = true,
  loading = "lazy",
  class: className = "",
} = Astro.props;

const image = media[id];
const copy = mediaCopy[lang][id];

const widths =
  variant === "grid"
    ? [320, 640, 960]
    : variant === "cover"
      ? [480, 800, 1200]
      : [640, 960, 1600];

const sizes =
  variant === "grid"
    ? "(max-width: 640px) 100vw, 480px"
    : variant === "cover"
      ? "(max-width: 768px) 100vw, 720px"
      : "(max-width: 768px) 100vw, 800px";
---

<figure class={`m-0 ${className}`}>
  <Picture
    src={image}
    formats={["avif", "webp"]}
    widths={widths}
    sizes={sizes}
    alt={copy.alt}
    loading={loading}
    decoding="async"
    class="block w-full rounded-2xl border border-imageframe bg-slate/40"
  />
  {
    caption && copy.caption && (
      <figcaption class="mt-3 font-mono text-[10px] leading-relaxed tracking-[0.5px] text-secondary">
        {copy.caption}
      </figcaption>
    )
  }
</figure>
