---
import Layout from "../../layouts/Layout.astro";
import { teamsIndex } from "../../i18n/content/teamsIndex";
import { meta } from "../../i18n/meta";
import { localizedPath } from "../../i18n/t";
import { HISTORICAL_SQUADS } from "../../data/historical/index";
import { playerRating } from "../../lib/draft/rating";
import type { Locale } from "../../i18n/config";
import { SITE_URL as siteUrl } from "../../lib/site";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import { ogImageFor } from "../../lib/og";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const c = teamsIndex[lang];
const m = meta[lang].teams(HISTORICAL_SQUADS.length);

const cards = HISTORICAL_SQUADS.map((s) => {
  const ratings = s.players.map((p) => playerRating(p));
  const avg = Math.round(ratings.reduce((a, b) => a + b, 0) / ratings.length);
  let top = s.players[0];
  for (const p of s.players) {
    if (playerRating(p) > playerRating(top)) top = p;
  }
  const display = s.name.replace(/\s+\d{4}$/, "");
  return {
    slug: s.nation.toLowerCase(),
    year: String(s.wcYear),
    name: display,
    avg,
    topName: top.name,
    topRating: Math.round(playerRating(top)),
  };
}).sort((a, b) => b.avg - a.avg);

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: m.title,
  description: m.description,
  url: new URL(localizedPath("/teams", lang), siteUrl).toString(),
  inLanguage: lang,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: cards.length,
    itemListElement: cards.map((card, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${card.name} ${card.year}`,
      url: new URL(
        localizedPath(`/teams/${card.slug}/${card.year}`, lang),
        siteUrl,
      ).toString(),
    })),
  },
};
---

<Layout
  lang={lang}
  path={path}
  title={m.title}
  description={m.description}
  ogImage={ogImageFor(path)}
  jsonLd={[breadcrumbLd(lang, [
    { name: "Home", path: "/" },
    { name: "Teams", path: "/teams" },
  ]), collectionLd]}
>
  <main class="min-h-screen bg-canvas text-white">
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
        <p
          class="font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
        >
          {c.eyebrow}
        </p>
        <h1
          class="mt-3 font-display text-5xl leading-[0.9] tracking-[0.5px] text-mint sm:text-6xl"
        >
          {c.h1}
        </h1>
        <p class="mt-6 max-w-3xl text-sm leading-relaxed text-secondary">
          {c.intro(cards.length)}
        </p>

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">{c.rankingTitle}</h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-secondary">
          {c.ranking.map((p) => <p>{p}</p>)}
        </div>

        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            cards.map((card) => (
              <li>
                <a
                  href={localizedPath(`/teams/${card.slug}/${card.year}`, lang)}
                  class="flex h-full flex-col rounded-2xl border border-white/10 bg-slate/40 p-5 transition-colors duration-150 hover:border-mint"
                >
                  <span class="font-display text-xl tracking-[0.5px]">
                    {card.name} {card.year}
                  </span>
                  <span class="mt-2 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                    {card.topName} · {card.topRating}
                  </span>
                  <span class="mt-auto pt-4 font-mono text-[11px] font-semibold tracking-[1.5px] text-mint">
                    {card.avg} OVR
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="mt-10 text-sm text-secondary">
          <a
            href={localizedPath("/blog", lang)}
            class="text-mint transition-colors hover:text-white"
          >
            {c.blogLink}
          </a>
        </p>
      </div>
    </section>
  </main>
</Layout>
