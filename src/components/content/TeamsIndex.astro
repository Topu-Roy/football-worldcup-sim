---
import Layout from "../../layouts/Layout.astro";
import { ChevronDown, Search } from "@lucide/astro";
import {
  teamsIndex,
  type TeamsIndexContent,
} from "../../i18n/content/teamsIndex";
import { teamDetail } from "../../i18n/content/teamDetail";
import { meta } from "../../i18n/meta";
import { localizedPath } from "../../i18n/t";
import { HISTORICAL_SQUADS } from "../../data/historical/index";
import { playerRating } from "../../lib/draft/rating";
import { FORMATIONS } from "../../lib/types";
import type { Locale } from "../../i18n/config";
import { SITE_URL as siteUrl } from "../../lib/site";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import { ogImageFor } from "../../lib/og";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const c = teamsIndex[lang] as TeamsIndexContent;
const detailCopy = teamDetail[lang];
const m = meta[lang].teams(HISTORICAL_SQUADS.length);

const teams = HISTORICAL_SQUADS.map((squad) => {
  const ratings = squad.players.map((p) => playerRating(p));
  const avg = Math.round(ratings.reduce((a, b) => a + b, 0) / ratings.length);
  let top = squad.players[0];
  for (const p of squad.players) {
    if (playerRating(p) > playerRating(top)) top = p;
  }
  const name = squad.name.replace(/\s+\d{4}$/, "");
  const slug = squad.nation.toLowerCase();
  const year = String(squad.wcYear);
  const formationLabel =
    Object.entries(FORMATIONS).find(
      ([, f]) =>
        f.GK === squad.formation.GK &&
        f.DEF === squad.formation.DEF &&
        f.MID === squad.formation.MID &&
        f.ATT === squad.formation.ATT,
    )?.[0] ?? "4-3-3";

  return {
    id: `${slug}-${year}`,
    name,
    year,
    avg,
    formationLabel,
    topName: top.name,
    topRating: Math.round(playerRating(top)),
    players: squad.players.map((p) => ({
      name: p.name,
      pos: p.bestPosition,
      rating: Math.round(playerRating(p)),
    })),
    otherYears: HISTORICAL_SQUADS.filter(
      (o) => o.nation === squad.nation && o.wcYear !== squad.wcYear,
    )
      .map((o) => ({
        id: `${o.nation.toLowerCase()}-${o.wcYear}`,
        year: String(o.wcYear),
      }))
      .sort((a, b) => Number(a.year) - Number(b.year)),
  };
}).sort((a, b) => b.avg - a.avg);

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: m.title,
  description: m.description,
  url: new URL(localizedPath("/teams", lang), siteUrl).toString(),
  inLanguage: lang,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: teams.length,
    itemListElement: teams.map((team, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${team.name} ${team.year}`,
      url: new URL(
        `${localizedPath("/teams", lang)}#${team.id}`,
        siteUrl,
      ).toString(),
    })),
  },
};

const faqLd =
  c.faq && c.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: lang,
        mainEntity: c.faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;
---

<Layout
  lang={lang}
  path={path}
  title={m.title}
  description={m.description}
  ogImage={ogImageFor(path)}
  jsonLd={[
    breadcrumbLd(lang, [
      { name: "Home", path: "/" },
      { name: "Teams", path: "/teams" },
    ]),
    collectionLd,
    ...(faqLd ? [faqLd] : []),
  ]}
>
  <main class="min-h-screen bg-canvas text-white">
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
        <p
          class="font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
        >
          {c.eyebrow}
        </p>
        <h1
          class="mt-3 font-display text-5xl leading-[0.9] tracking-[0.5px] text-mint sm:text-6xl"
        >
          {c.h1}
        </h1>
        <p class="mt-6 max-w-3xl text-sm leading-relaxed text-secondary">
          {c.intro(teams.length)}
        </p>

        {
          c.eras && c.eras.length > 0 && (
            <>
              <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
                {c.erasTitle}
              </h2>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {c.eras.map((era) => (
                  <div class="rounded-2xl border border-white/10 bg-slate/40 p-5">
                    <span class="font-mono text-[10px] font-semibold tracking-[1.5px] text-mint uppercase">
                      {era.years}
                    </span>
                    <h3 class="mt-2 block font-display text-xl tracking-[0.5px]">
                      {era.title}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-secondary">
                      {era.body}
                    </p>
                  </div>
                ))}
              </div>
            </>
          )
        }

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
          {c.rankingTitle}
        </h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-secondary">
          {c.ranking.map((p) => <p>{p}</p>)}
        </div>
        {
          c.sourceNote && (
            <p class="mt-6 rounded-2xl border border-white/10 bg-slate/20 p-4 font-mono text-[10px] leading-relaxed tracking-[0.5px] text-secondary uppercase">
              {c.sourceNote}
            </p>
          )
        }

        <div
          class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="relative w-full sm:max-w-xs">
            <label class="sr-only" for="team-search">Search squads</label>
            <Search
              class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-secondary"
            />
            <input
              id="team-search"
              type="search"
              autocomplete="off"
              placeholder="Search nation or year"
              class="w-full rounded-full border border-white/15 bg-slate/40 py-2.5 pr-4 pl-10 text-sm text-white placeholder:text-secondary focus:border-mint"
            />
          </div>
          <p
            id="team-count"
            class="font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase"
            aria-live="polite"
          >
            {teams.length} squads
          </p>
        </div>
        <p
          id="team-empty"
          class="mt-8 hidden rounded-2xl border border-white/10 bg-slate/20 px-5 py-10 text-center text-sm text-secondary"
        >
          No squads match that search. Try a nation name or a year.
        </p>

        <ul id="team-list" class="mt-6 space-y-3">
          {
            teams.map((team) => (
              <li
                id={team.id}
                class="scroll-mt-24"
                data-team
                data-search={`${team.name} ${team.year} ${team.formationLabel}`.toLowerCase()}
              >
                <details class="group rounded-2xl border border-white/10 bg-slate/40 transition-colors open:border-mint/40">
                  <summary class="flex cursor-pointer list-none flex-wrap items-baseline gap-x-4 gap-y-1 p-5 [&::-webkit-details-marker]:hidden">
                    <span class="font-display text-xl tracking-[0.5px]">
                      {team.name} {team.year}
                    </span>
                    <span class="font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                      {team.formationLabel} · {team.avg} OVR
                    </span>
                    <span class="ml-auto font-mono text-[10px] font-semibold tracking-[1.5px] text-mint uppercase">
                      {team.topName} · {team.topRating}
                    </span>
                    <ChevronDown class="size-4 shrink-0 text-secondary transition-transform duration-150 group-open:rotate-180" />
                  </summary>

                  <div class="border-t border-white/10 px-5 py-5">
                    <p class="text-sm leading-relaxed text-secondary">
                      {detailCopy.intro({
                        nation: team.name,
                        year: team.year,
                        formation: team.formationLabel,
                        top: team.topName,
                        rating: team.topRating,
                      })}
                    </p>

                    {team.otherYears.length > 0 && (
                      <div class="mt-5">
                        <p class="font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                          {detailCopy.other(team.name)}
                        </p>
                        <ul class="mt-2 flex flex-wrap gap-2">
                          {team.otherYears.map((other) => (
                            <li>
                              <a
                                href={`#${other.id}`}
                                class="rounded-full border border-white/15 px-4 py-1.5 font-mono text-[10px] font-semibold tracking-[1.5px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
                              >
                                {other.year}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}

                    <h3 class="mt-6 font-display text-2xl tracking-[0.5px]">
                      {detailCopy.rosterTitle}
                    </h3>
                    <ul class="mt-3 divide-y divide-white/10 rounded-2xl border border-white/10">
                      {team.players.map((p) => (
                        <li class="flex items-center justify-between px-5 py-2.5">
                          <span class="text-sm">{p.name}</span>
                          <span class="flex items-center gap-3">
                            <span class="font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                              {p.pos}
                            </span>
                            <span class="font-mono text-[11px] font-semibold tracking-[1.5px] text-mint">
                              {p.rating}
                            </span>
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>

        {
          c.faqTitle && c.faq && c.faq.length > 0 && (
            <>
              <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
                {c.faqTitle}
              </h2>
              <div class="mt-6 space-y-4">
                {c.faq.map((f) => (
                  <div class="rounded-2xl border border-white/10 bg-slate/40 p-5">
                    <h3 class="block font-display text-lg tracking-[0.5px]">
                      {f.q}
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-secondary">
                      {f.a}
                    </p>
                  </div>
                ))}
              </div>
            </>
          )
        }

        {
          c.playCta && c.howCta && (
            <div class="mt-10 flex flex-wrap items-center gap-3">
              <a
                href="/game"
                class="rounded-full bg-mint px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
              >
                {c.playCta}
              </a>
              <a
                href={localizedPath("/how-to-play", lang)}
                class="rounded-full border border-white/15 px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
              >
                {c.howCta}
              </a>
            </div>
          )
        }

        <p class="mt-8 text-sm text-secondary">
          <a
            href={localizedPath("/blog", lang)}
            class="text-mint transition-colors hover:text-white"
          >
            {c.blogLink}
          </a>
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const input = document.getElementById("team-search");
      const items = Array.from(document.querySelectorAll("[data-team]"));
      const count = document.getElementById("team-count");
      const empty = document.getElementById("team-empty");
      const total = items.length;

      /** Filter the squad list by nation, year or formation. */
      const filter = () => {
        const q = (input?.value ?? "").trim().toLowerCase();
        let shown = 0;
        for (const el of items) {
          const haystack = el.getAttribute("data-search") ?? "";
          const match = !q || haystack.includes(q);
          el.hidden = !match;
          if (match) shown += 1;
        }
        if (count) {
          count.textContent = q
            ? `${shown} of ${total} squads`
            : `${total} squads`;
        }
        if (empty) empty.classList.toggle("hidden", shown !== 0);
      };

      input?.addEventListener("input", filter);

      const openTarget = () => {
        const id = decodeURIComponent(window.location.hash.slice(1));
        if (!id) return;
        const target = document.getElementById(id);
        // A filtered-out squad can't be scrolled to: clear the search first.
        if (target?.hidden) {
          if (input) input.value = "";
          filter();
        }
        const details = target?.querySelector("details");
        if (details) details.open = true;
        target?.scrollIntoView({ block: "start" });
      };
      openTarget();
      window.addEventListener("hashchange", openTarget);
    })();
  </script>
</Layout>
