---
import Layout from "../../layouts/Layout.astro";
import { teamDetail } from "../../i18n/content/teamDetail";
import { meta } from "../../i18n/meta";
import { localizedPath } from "../../i18n/t";
import type { Locale } from "../../i18n/config";

interface PlayerRow {
  name: string;
  rating: number;
  pos: string;
}

interface Props {
  lang: Locale;
  path: string;
  nation: string;
  year: string;
  formationLabel: string;
  topName: string;
  topRating: number;
  avgRating: number;
  players: PlayerRow[];
  yearList: { year: string; slug: string }[];
}

const { lang, path, nation, year, formationLabel, topName, topRating, avgRating, players, yearList } =
  Astro.props;
const c = teamDetail[lang];
const m = meta[lang].team(nation, year);

const introArgs = { nation, year, formation: formationLabel, top: topName, rating: topRating };
const h1 = `${nation} ${year} Team - Fantasy Football World Cup`;
---

<Layout lang={lang} path={path} title={m.title} description={m.description}>
  <main class="min-h-screen bg-canvas text-white">
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
        <p
          class="font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
        >
          {c.eyebrow}
        </p>
        <h1
          class="mt-3 font-display text-5xl leading-[0.9] tracking-[0.5px] text-mint sm:text-6xl"
        >
          {h1}
        </h1>

        <p class="mt-6 text-sm leading-relaxed text-secondary">{c.intro(introArgs)}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/game"
            class="rounded-full bg-mint px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
          >
            {c.ctaPlay}
          </a>
          <a
            href={localizedPath("/teams", lang)}
            class="rounded-full border border-white/15 px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
          >
            {c.ctaAll}
          </a>
        </div>

        {
          yearList.length > 0 && (
            <div class="mt-8">
              <p class="font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                {c.other(nation)}
              </p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {yearList.map((y) => (
                  <li>
                    <a
                      href={localizedPath(`/teams/${y.slug}/${y.year}`, lang)}
                      class="rounded-full border border-white/15 px-4 py-1.5 font-mono text-[10px] font-semibold tracking-[1.5px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
                    >
                      {y.year}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
          {c.wcHeading(nation, year)}
        </h2>
        <p class="mt-2 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
          {formationLabel} · {avgRating} OVR · {topName} {topRating}
        </p>

        <h3 class="mt-8 font-display text-2xl tracking-[0.5px]">{c.rosterTitle}</h3>
        <ul class="mt-4 divide-y divide-white/10 rounded-2xl border border-white/10 bg-slate/40">
          {
            players.map((p) => (
              <li class="flex items-center justify-between px-5 py-3">
                <span class="text-sm">{p.name}</span>
                <span class="flex items-center gap-3">
                  <span class="font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                    {p.pos}
                  </span>
                  <span class="font-mono text-[11px] font-semibold tracking-[1.5px] text-mint">
                    {p.rating}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>

        <details class="mt-10 group">
          <summary
            class="cursor-pointer font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
          >
            {c.readMoreBtn}
          </summary>
          <div class="mt-4 space-y-4 text-sm leading-relaxed text-secondary">
            {c.readMore(introArgs).map((p) => <p>{p}</p>)}
          </div>
        </details>
      </div>
    </section>
  </main>
</Layout>
