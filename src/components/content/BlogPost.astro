---
import Layout from "../../layouts/Layout.astro";
import { blog } from "../../i18n/content/blog";
import { localizedPath } from "../../i18n/t";
import { ui } from "../../i18n/ui";
import type { Locale } from "../../i18n/config";
import { SITE_URL as siteUrl, SITE_NAME } from "../../lib/site";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import { ogImageFor } from "../../lib/og";

interface Props {
  lang: Locale;
  path: string;
  slug: string;
}

const { lang, path, slug } = Astro.props;
const c = blog[lang];
const t = ui[lang];
const post = c.posts.find((p) => p.slug === slug);

if (!post) return Astro.redirect("/404");

const postUrl = new URL(localizedPath(path, lang), siteUrl).toString();
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  author: { "@type": "Organization", name: SITE_NAME, url: siteUrl },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    logo: { "@type": "ImageObject", url: `${siteUrl}/favicon.svg` },
  },
  image: `${siteUrl}/og/blog/${slug}/index.png`,
};
---

<Layout
  lang={lang}
  path={path}
  title={post.title}
  description={post.excerpt}
  ogType="article"
  ogImage={ogImageFor(path)}
  jsonLd={[breadcrumbLd(lang, [
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
    { name: post.title, path },
  ]), articleLd]}
>
  <main class="min-h-screen bg-canvas text-white">
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
        <a
          href={localizedPath("/blog", lang)}
          class="font-mono text-[11px] font-semibold tracking-[1.5px] text-mint uppercase transition-colors hover:text-white"
          >&larr; Blog</a
        >
        <h1
          class="mt-4 font-display text-5xl leading-[0.9] tracking-[0.5px] text-mint sm:text-6xl"
        >
          {post.title}
        </h1>
        <p
          class="mt-3 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase"
        >
          <time datetime={post.date}>{post.date}</time>
        </p>

        <div class="mt-8 space-y-8">
          {
            post.sections.map((s) => (
              <section>
                <h2 class="font-display text-3xl tracking-[0.5px]">{s.h2}</h2>
                <div class="mt-4 space-y-4 text-sm leading-relaxed text-secondary">
                  {s.body.map((para) => (
                    <p>{para}</p>
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <div class="mt-12 rounded-2xl border border-white/10 bg-slate/40 p-6">
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a
                href={localizedPath("/game", lang)}
                class="text-mint transition-colors hover:text-white"
              >
                {t.seoLinks.game}
              </a>
            </li>
            <li>
              <a
                href={localizedPath("/teams", lang)}
                class="text-mint transition-colors hover:text-white"
              >
                {t.seoLinks.teams}
              </a>
            </li>
            <li>
              <a
                href={localizedPath("/how-to-play", lang)}
                class="text-mint transition-colors hover:text-white"
              >
                {t.seoLinks.howToPlay}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>
