---
import Layout from "../../layouts/Layout.astro";
import { howToPlay } from "../../i18n/content/howToPlay";
import { meta } from "../../i18n/meta";
import { localizedPath } from "../../i18n/t";
import type { Locale } from "../../i18n/config";
import { SITE_URL as siteUrl } from "../../lib/site";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import { ogImageFor } from "../../lib/og";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const c = howToPlay[lang];
const m = meta[lang].howToPlay;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: m.title,
  description: m.description,
  inLanguage: lang,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(localizedPath(path, lang), siteUrl).toString(),
  },
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: c.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  lang={lang}
  path={path}
  title={m.title}
  description={m.description}
  ogImage={ogImageFor(path)}
  jsonLd={[
    breadcrumbLd(lang, [
      { name: "Home", path: "/" },
      { name: "How to play", path: "/how-to-play" },
    ]),
    articleLd,
    faqLd,
  ]}
>
  <main class="min-h-screen bg-canvas text-white">
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
        <h1
          class="font-display text-5xl leading-[0.9] tracking-[0.5px] text-mint sm:text-6xl"
        >
          {c.h1}
        </h1>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-secondary">
          {c.hero.map((p) => <p>{p}</p>)}
        </div>

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
          {c.stepsTitle}
        </h2>
        <ol class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            c.steps.map((step) => (
              <li class="flex flex-col rounded-2xl border border-white/10 bg-slate/40 p-5">
                <span class="font-mono text-[10px] font-semibold tracking-[1.5px] text-mint">
                  {step.n}
                </span>
                <h3 class="mt-3 block font-display text-xl tracking-[0.5px]">
                  {step.title}
                </h3>
                <span class="mt-2 block text-sm leading-relaxed text-secondary">
                  {step.body}
                </span>
              </li>
            ))
          }
        </ol>

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
          {c.loopTitle}
        </h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-secondary">
          {c.loop.map((p) => <p>{p}</p>)}
        </div>

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
          {c.faqTitle}
        </h2>
        <div class="mt-6 space-y-4">
          {
            c.faq.map((f) => (
              <div class="rounded-2xl border border-white/10 bg-slate/40 p-5">
                <h3 class="block font-display text-lg tracking-[0.5px]">
                  {f.q}
                </h3>
                <span class="mt-2 block text-sm leading-relaxed text-secondary">
                  {f.a}
                </span>
              </div>
            ))
          }
        </div>

        <div class="mt-10">
          <a
            href="/game"
            class="rounded-full bg-mint px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
          >
            {c.ctaStart}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
