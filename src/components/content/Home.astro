---
import Layout from "../../layouts/Layout.astro";
import { home } from "../../i18n/content/home";
import { meta } from "../../i18n/meta";
import { localizedPath } from "../../i18n/t";
import { buildPreviewSlides } from "../../data/preview-squads";
import PreviewCarousel from "../../components/PreviewCarousel.astro";
import type { Locale } from "../../i18n/config";
import { SITE_NAME as siteName, SITE_URL as siteUrl } from "../../lib/site";
import { ogImageFor } from "../../lib/og";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const c = home[lang];
const m = meta[lang].home;
const previewSlides = buildPreviewSlides();

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: siteName,
  url: new URL(localizedPath("/", lang), siteUrl).toString(),
  applicationCategory: "GameApplication",
  operatingSystem: "Web",
  browserRequirements: "Requires JavaScript",
  description: m.description,
  inLanguage: lang,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<Layout
  lang={lang}
  path={path}
  title={m.title}
  description={m.description}
  ogImage={ogImageFor("/")}
  jsonLd={webAppLd}
>
  <main class="min-h-screen bg-canvas text-white">
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -top-48 left-1/2 h-96 w-2xl -translate-x-1/2 rounded-full bg-mint/15 blur-[120px]"
      >
      </div>
      <div
        class="pointer-events-none absolute top-24 -left-32 h-64 w-64 rounded-full bg-uv/20 blur-[100px]"
      >
      </div>

      <div
        class="relative mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24 sm:pb-16"
      >
        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div class="min-w-0 text-center lg:text-left">
            <p
              class="font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
            >
              Eleven Fantasy
            </p>
            <h1
              class="mt-4 font-display text-4xl text-balance wrap-break-word text-mint sm:text-5xl md:text-6xl lg:text-7xl"
            >
              {c.h1}
            </h1>
            <p
              id="hero-desc"
              class="mx-auto mt-6 line-clamp-3 max-w-2xl wrap-break-word text-secondary lg:mx-0 lg:line-clamp-none"
            >
              {c.hero}
            </p>
            <button
              type="button"
              id="hero-toggle"
              data-more={c.showMore}
              data-less={c.showLess}
              aria-expanded="false"
              aria-controls="hero-desc"
              class="mx-auto mt-2 block font-mono text-[11px] font-semibold tracking-[1.5px] text-mint uppercase transition-colors hover:text-white lg:hidden"
            >
              {c.showMore}
            </button>

            <div
              class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start"
            >
              <a
                href="/game"
                class="rounded-full bg-mint px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
              >
                {c.ctaPlay}
              </a>
              <a
                href={localizedPath("/how-to-play", lang)}
                class="rounded-full border border-white/15 px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
              >
                {c.ctaHow}
              </a>
            </div>

            <ul
              class="mt-10 flex flex-wrap items-center justify-center gap-2 lg:justify-start"
            >
              {
                c.chips.map((s) => (
                  <li class="rounded-full border border-white/15 bg-slate/40 px-4 py-1.5 font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
                    {s}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="flex min-w-0 justify-center lg:justify-end">
            <PreviewCarousel slides={previewSlides} />
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-white/10 bg-slate/20">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
        <p
          class="text-center font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
        >
          {c.stepsEyebrow}
        </p>
        <h2
          class="mt-3 text-center font-display text-4xl leading-[0.9] tracking-[0.5px] sm:text-5xl"
        >
          {c.stepsTitle}
        </h2>
        <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            c.steps.map((step) => (
              <li class="flex flex-col rounded-2xl border border-white/10 bg-slate/40 p-5">
                <span class="font-mono text-[10px] font-semibold tracking-[1.5px] text-mint">
                  {step.n}
                </span>
                <h3 class="mt-4 block font-display text-xl tracking-[0.5px]">
                  {step.title}
                </h3>
                <span class="mt-2 block text-xs leading-relaxed text-secondary">
                  {step.body}
                </span>
              </li>
            ))
          }
        </ol>

        <div
          class="mx-auto mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-secondary"
        >
          {c.loop.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="border-t border-white/10">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
        <p
          class="text-center font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
        >
          {c.squadsEyebrow}
        </p>
        <h2
          class="mt-3 text-center font-display text-4xl leading-[0.9] tracking-[0.5px] sm:text-5xl"
        >
          {c.squadsTitle}
        </h2>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href={localizedPath("/teams", lang)}
            class="rounded-full border border-white/15 px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
          >
            {c.squadsCta1}
          </a>
          <a
            href="/game"
            class="rounded-full bg-mint px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
          >
            {c.squadsCta2}
          </a>
          <a
            href={localizedPath("/blog", lang)}
            class="rounded-full border border-white/15 px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
          >
            {c.blogCta}
          </a>
        </div>

        <div
          class="mx-auto mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-secondary"
        >
          {c.squads.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section class="border-t border-white/10">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
        <p
          class="text-center font-mono text-[11px] font-semibold tracking-[1.8px] text-mint uppercase"
        >
          {c.playEyebrow}
        </p>
        <h2
          class="mt-3 text-center font-display text-4xl leading-[0.9] tracking-[0.5px] sm:text-5xl"
        >
          {c.playTitle}
        </h2>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href={localizedPath("/how-to-play", lang)}
            class="rounded-full border border-white/15 px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
          >
            {c.playCta1}
          </a>
          <a
            href="/game"
            class="rounded-full bg-mint px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
          >
            {c.playCta2}
          </a>
        </div>

        <div
          class="mx-auto mt-10 max-w-3xl space-y-4 text-sm leading-relaxed text-secondary"
        >
          {c.play.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const btn = document.getElementById("hero-toggle");
  const desc = document.getElementById("hero-desc");
  if (btn && desc) {
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      desc.classList.toggle("line-clamp-3");
      btn.textContent = expanded
        ? (btn.dataset.more ?? "Show more")
        : (btn.dataset.less ?? "Show less");
    });
  }
</script>
