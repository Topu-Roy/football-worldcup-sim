---
import Layout from "../../layouts/Layout.astro";
import { contact } from "../../i18n/content/contact";
import { meta } from "../../i18n/meta";
import { localizedPath } from "../../i18n/t";
import { ui } from "../../i18n/ui";
import type { Locale } from "../../i18n/config";
import { SITE_URL as siteUrl } from "../../lib/site";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import { ogImageFor } from "../../lib/og";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const c = contact[lang];
const t = ui[lang];
const m = meta[lang].contact;
const EMAIL = "hello@worldcupdraftsimulator.com";

const pageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: m.title,
  description: m.description,
  inLanguage: lang,
  url: new URL(localizedPath(path, lang), siteUrl).toString(),
  isPartOf: { "@id": `${siteUrl}/#website` },
};
---

<Layout
  lang={lang}
  path={path}
  title={m.title}
  description={m.description}
  ogImage={ogImageFor(path)}
  jsonLd={[
    breadcrumbLd(lang, [
      { name: "Home", path: "/" },
      { name: "Contact", path: "/contact" },
    ]),
    pageLd,
  ]}
>
  <main class="min-h-screen bg-canvas text-white">
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
        <h1
          class="font-display text-5xl leading-[0.9] tracking-[0.5px] text-mint sm:text-6xl"
        >
          {c.h1}
        </h1>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-secondary">
          {c.hero.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-8">
          <a
            href={`mailto:${EMAIL}`}
            class="rounded-full bg-mint px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-black uppercase transition-colors duration-150 hover:bg-white"
          >
            {c.ctaEmail}
          </a>
        </div>

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
          {c.bodyTitle}
        </h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-secondary">
          {c.body.map((p) => <p>{p}</p>)}
        </div>

        <h2 class="mt-12 font-display text-3xl tracking-[0.5px]">
          {c.exploreTitle}
        </h2>
        <ul class="mt-4 flex flex-col gap-2 text-sm">
          <li>
            <a
              href={localizedPath("/game", lang)}
              class="text-mint transition-colors hover:text-white"
            >
              {t.seoLinks.game}
            </a>
          </li>
          <li>
            <a
              href={localizedPath("/how-to-play", lang)}
              class="text-mint transition-colors hover:text-white"
            >
              {t.seoLinks.howToPlay}
            </a>
          </li>
          <li>
            <a
              href={localizedPath("/teams", lang)}
              class="text-mint transition-colors hover:text-white"
            >
              {t.seoLinks.teams}
            </a>
          </li>
          <li>
            <a
              href={localizedPath("/blog", lang)}
              class="text-mint transition-colors hover:text-white"
            >
              {t.seoLinks.blog}
            </a>
          </li>
          <li>
            <a
              href={localizedPath("/about", lang)}
              class="text-mint transition-colors hover:text-white"
            >
              {t.nav.about}
            </a>
          </li>
        </ul>

        <div class="mt-8">
          <a
            href={`mailto:${EMAIL}`}
            class="rounded-full border border-white/15 px-8 py-3 font-mono text-[11px] font-semibold tracking-[1.8px] text-white uppercase transition-colors duration-150 hover:border-mint hover:text-mint"
          >
            {c.contactCta}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
