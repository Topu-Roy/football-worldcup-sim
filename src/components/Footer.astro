---
import { getLocale, localizedPath } from "../i18n/t";
import { ui } from "../i18n/ui";
import { version } from "../../package.json";

const locale = getLocale(Astro.url.pathname);
const labels = ui[locale];
---

<footer class="site-footer">
  <div class="inner">
    <p class="credits">Eleven Fantasy &middot; v{version}</p>
    <p class="credits">{labels.footer.tagline}</p>
    <nav class="legal" aria-label="Footer">
      <a href={localizedPath("/about", locale)}>{labels.nav.about}</a>
      <a href={localizedPath("/contact", locale)}>{labels.nav.contact}</a>
      <a href="/privacy/">{labels.nav.privacy}</a>
      <a href="/terms-and-conditions/">{labels.nav.terms}</a>
    </nav>
    <button type="button" class="to-top" id="footer-back-to-top"
      >{labels.footer.backToTop}</button
    >
  </div>
</footer>

<script>
  const backToTop = document.getElementById("footer-back-to-top");
  backToTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<style>
  .site-footer {
    background: var(--color-canvas);
    border-top: 1px solid var(--color-slate);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1300px;
    margin: 0 auto;
    padding: 24px;
  }

  .credits {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin: 0;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .legal a {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .legal a:hover {
    color: var(--color-mint);
  }

  .to-top {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-mint);
    background: transparent;
    border: 1px solid var(--color-mint);
    border-radius: 40px;
    padding: 8px 20px;
    cursor: pointer;
    transition:
      background 150ms ease,
      color 150ms ease;
  }

  .to-top:hover {
    background: var(--color-mint);
    color: #000000;
  }

  .to-top:focus-visible {
    outline: 1px solid #1eaedb;
  }

  @media (max-width: 549px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 20px 16px;
    }

    .to-top {
      width: 100%;
      text-align: center;
    }
  }
</style>
