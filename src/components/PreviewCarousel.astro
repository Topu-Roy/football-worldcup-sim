---
import PitchGraphic from "./PitchGraphic.astro";
import type { PreviewSlide } from "../data/preview-squads";
import { shortName } from "../lib/shortName";

interface Props {
  slides: PreviewSlide[];
}

const { slides } = Astro.props;

/** Two-digit slide counter, e.g. "01 / 12". */
const pad = (n: number) => String(n).padStart(2, "0");
const totalLabel = pad(slides.length);
---

{
  slides.length > 0 && (
    <div
      class="relative mx-auto w-full max-w-[420px] lg:max-w-[560px] xl:max-w-[640px]"
      id="preview-carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label="Historic World Cup XIs"
    >
      <div class="overflow-hidden rounded-3xl border border-white/10 bg-slate/30">
        <div class="carousel-track flex">
          {slides.map((s, i) => (
            <div
              class="carousel-slide w-full shrink-0 p-3 sm:p-6"
              data-index={i}
              aria-roledescription="slide"
              aria-label={`${s.team} — ${s.formationLabel} formation`}
              aria-hidden={i === 0 ? "false" : "true"}
            >
              <div class="pitch-wrap relative mx-auto aspect-3/4 w-full max-w-[260px] sm:max-w-sm lg:max-w-md xl:max-w-lg">
                <PitchGraphic id={s.id} />
                {s.players.map((p) => (
                  <div
                    class="chip"
                    style={`left:${p.x}%; top:${p.y}%`}
                    aria-label={`${p.name}, rating ${p.rating}`}
                  >
                    <span class={`chip-ball ${p.tier}`}>{p.jersey}</span>
                    <span class="chip-name">{shortName(p.name)}</span>
                    <span class="chip-rating">{p.rating}</span>
                  </div>
                ))}
              </div>

              <div class="mx-auto mt-3 flex w-full max-w-[260px] items-center justify-between gap-2 border-t border-white/10 pt-3 sm:max-w-sm lg:max-w-md xl:max-w-lg">
                <div class="min-w-0">
                  <p class="truncate font-display text-base leading-none tracking-[0.5px] sm:text-lg">
                    {s.team}
                  </p>
                  <p class="mt-1 font-mono text-[10px] tracking-[1.5px] text-secondary uppercase">
                    {s.formationLabel} · best XI
                  </p>
                </div>
                <span class="shrink-0 rounded-full border border-mint/40 bg-mint/10 px-2.5 py-1 font-mono text-[10px] font-bold text-mint">
                  ★ {s.topRating}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button
        type="button"
        class="carousel-prev absolute top-1/2 left-2 z-20 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-canvas/80 p-2 text-white backdrop-blur transition-colors hover:border-mint hover:text-mint sm:flex"
        aria-label="Previous team"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>
      <button
        type="button"
        class="carousel-next absolute top-1/2 right-2 z-20 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-canvas/80 p-2 text-white backdrop-blur transition-colors hover:border-mint hover:text-mint sm:flex"
        aria-label="Next team"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18l6-6-6-6" />
        </svg>
      </button>

      <div class="mt-4 flex items-center justify-between gap-2">
        <p class="font-mono text-[10px] font-semibold tracking-[1.5px] text-secondary uppercase">
          <span data-counter>
            {pad(1)} / {totalLabel}
          </span>
        </p>

        <div
          class="carousel-dots flex items-center justify-center gap-1"
          role="group"
          aria-label="Choose team"
        >
          {slides.map((s, i) => (
            <button
              type="button"
              class:list={[
                "carousel-dot group flex h-6 w-6 items-center justify-center",
                { "is-window": i < 5 },
              ]}
              data-index={i}
              aria-label={`Go to ${s.team}`}
              aria-current={i === 0 ? "true" : "false"}
            >
              <span class="carousel-dot-mark block h-2 w-2 rounded-full bg-white/25 transition-all duration-150 group-hover:bg-white/50" />
            </button>
          ))}
        </div>

        <button
          type="button"
          class="carousel-pause flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/15 text-secondary transition-colors hover:border-mint hover:text-mint"
          aria-label="Pause slideshow"
          aria-pressed="false"
        >
          <svg
            class="icon-pause h-3 w-3"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <rect x="6" y="5" width="4" height="14" rx="1" />
            <rect x="14" y="5" width="4" height="14" rx="1" />
          </svg>
          <svg
            class="icon-play hidden h-3 w-3"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
        </button>
      </div>

      <p class="sr-only" aria-live="polite" data-status />
    </div>
  )
}

<style>
  .carousel-track {
    transition: transform 400ms ease;
    will-change: transform;
    touch-action: pan-y;
  }

  .pitch-wrap {
    container-type: inline-size;
  }

  .chip {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    width: clamp(52px, 18cqw, 100px);
    text-align: center;
    pointer-events: none;
  }

  .chip-ball {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(20px, 8cqw, 44px);
    height: clamp(20px, 8cqw, 44px);
    border-radius: 9999px;
    background: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(0.5rem, 2.8cqw, 0.9rem);
    line-height: 1;
  }

  .chip-ball.elite {
    border-color: #3cffd0;
    box-shadow: 0 0 10px rgba(60, 255, 208, 0.7);
  }

  .chip-ball.star {
    border-color: rgba(60, 255, 208, 0.55);
  }

  .chip-name {
    margin-top: 3px;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: clamp(0.5rem, 2.6cqw, 0.85rem);
    font-weight: 700;
    line-height: 1.1;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
  }

  .chip-rating {
    font-family: var(--font-mono);
    font-size: clamp(0.45rem, 2.2cqw, 0.72rem);
    font-weight: 700;
    color: #3cffd0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
  }

  .carousel-dot.is-active .carousel-dot-mark {
    background: var(--color-mint);
    width: 1.25rem;
    border-radius: 9999px;
  }

  /* Mobile keeps only a five-dot window around the active slide. */
  @media (max-width: 639px) {
    .carousel-dot {
      display: none;
    }

    .carousel-dot.is-window {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }
</style>

<script>
  const root = document.getElementById("preview-carousel");
  if (root) {
    const track = root.querySelector<HTMLElement>(".carousel-track");
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>(".carousel-slide"),
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".carousel-dot"),
    );
    const pauseBtn = root.querySelector<HTMLButtonElement>(".carousel-pause");
    const iconPause = pauseBtn?.querySelector<HTMLElement>(".icon-pause");
    const iconPlay = pauseBtn?.querySelector<HTMLElement>(".icon-play");
    const counter = root.querySelector<HTMLElement>("[data-counter]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const total = slides.length;

    if (track && total > 0) {
      let i = 0;
      let paused = false;
      let timer: number | null = null;
      let startX: number | null = null;
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const pad = (n: number) => String(n).padStart(2, "0");

      const go = (n: number, announce = true) => {
        i = (n + total) % total;
        track.style.transform = `translateX(-${i * 100}%)`;
        slides.forEach((s, idx) =>
          s.setAttribute("aria-hidden", idx === i ? "false" : "true"),
        );

        // Keep a five-dot window on mobile, clamped at both ends.
        const windowStart = Math.max(0, Math.min(i - 2, total - 5));
        dots.forEach((d, idx) => {
          d.setAttribute("aria-current", idx === i ? "true" : "false");
          d.classList.toggle("is-active", idx === i);
          d.classList.toggle(
            "is-window",
            idx >= windowStart && idx < windowStart + 5,
          );
        });

        if (counter) counter.textContent = `${pad(i + 1)} / ${pad(total)}`;
        if (status && announce) {
          const label = slides[i]?.getAttribute("aria-label") ?? "";
          status.textContent = `Slide ${i + 1} of ${total}: ${label}`;
        }
      };

      const stop = () => {
        if (timer !== null) {
          window.clearInterval(timer);
          timer = null;
        }
      };
      const start = () => {
        stop();
        if (paused || reduced || document.hidden) return;
        timer = window.setInterval(() => go(i + 1, false), 5000);
      };

      const next = () => {
        go(i + 1);
        start();
      };
      const prev = () => {
        go(i - 1);
        start();
      };

      root.querySelector(".carousel-prev")?.addEventListener("click", prev);
      root.querySelector(".carousel-next")?.addEventListener("click", next);
      dots.forEach((d, idx) =>
        d.addEventListener("click", () => {
          go(idx);
          start();
        }),
      );

      pauseBtn?.addEventListener("click", () => {
        paused = !paused;
        pauseBtn.setAttribute("aria-pressed", String(paused));
        pauseBtn.setAttribute(
          "aria-label",
          paused ? "Play slideshow" : "Pause slideshow",
        );
        iconPause?.classList.toggle("hidden", paused);
        iconPlay?.classList.toggle("hidden", !paused);
        if (paused) stop();
        else start();
      });

      // Swipe on touch/pen; vertical page scroll stays native (touch-action).
      track.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" && event.button !== 0) return;
        startX = event.clientX;
        stop();
        try {
          track.setPointerCapture(event.pointerId);
        } catch {
          // Pointer capture unavailable: pointerup on the track still works.
        }
      });
      track.addEventListener("pointerup", (event) => {
        if (startX === null) return;
        const dx = event.clientX - startX;
        startX = null;
        if (Math.abs(dx) > 40) {
          if (dx < 0) next();
          else prev();
        } else {
          start();
        }
      });
      track.addEventListener("pointercancel", () => {
        startX = null;
        start();
      });

      root.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          prev();
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          next();
        }
      });

      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", start);
      root.addEventListener("focusin", stop);
      root.addEventListener("focusout", start);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });

      go(0, false);
      start();
    }
  }
</script>
