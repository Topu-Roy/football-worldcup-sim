---
---
<header class="site-header">
  <div class="inner">
    <a href="/" class="wordmark">WORLD CUP <span>/</span> SIM</a>
    <nav class="nav" aria-label="Primary">
      <a href="/squads/" class="nav-link">Squads</a>
      <a href="/how-to-play/" class="nav-link">How to Play</a>
      <a href="/game" class="nav-link" id="new-draft">New Draft</a>
    </nav>
  </div>
</header>

<script>
  const newDraft = document.getElementById("new-draft");
  newDraft?.addEventListener("click", (e) => {
    e.preventDefault();
    const onGame = window.location.pathname.startsWith("/game");
    if (onGame) {
      window.dispatchEvent(new CustomEvent("wc:reset"));
    } else {
      window.location.href = "/game";
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #131313;
    border-bottom: 1px solid #2d2d2d;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1300px;
    margin: 0 auto;
    padding: 14px 24px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    line-height: 0.9;
    letter-spacing: 1.07px;
    color: #ffffff;
    text-decoration: none;
  }

  .wordmark span {
    color: #3cffd0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    line-height: 2;
    text-transform: uppercase;
    color: #ffffff;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 20px;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: #3860be;
  }

  #new-draft {
    color: #000000;
    background: #3cffd0;
    margin-left: 8px;
    transition: background 180ms ease, color 180ms ease;
  }

  #new-draft:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #000000;
  }

  #new-draft:focus-visible {
    outline: 1px solid #1eaedb;
  }

  @media (max-width: 549px) {
    .wordmark {
      font-size: 1.125rem;
    }

    .inner {
      padding: 12px 16px;
    }

    .nav-link {
      letter-spacing: 1px;
      padding: 6px 6px;
    }

    #new-draft {
      margin-left: 4px;
    }
  }
</style>