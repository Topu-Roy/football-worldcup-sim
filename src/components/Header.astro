---
import { ChevronDown, Menu, X } from "@lucide/astro";
import { getLocale, localizedPath } from "../i18n/t";
import { ui } from "../i18n/ui";
import LocaleSwitcher from "./LocaleSwitcher.astro";

const locale = getLocale(Astro.url.pathname);
const labels = ui[locale];

/** Primary pages stay visible in the wide nav; the rest live in the "More" menu. */
const primaryLinks = [
  { href: localizedPath("/teams", locale), label: labels.nav.teams },
  { href: localizedPath("/how-to-play", locale), label: labels.nav.howToPlay },
  { href: localizedPath("/blog", locale), label: labels.nav.blog },
  { href: "/history/", label: labels.nav.history },
];

const moreLinks = [
  { href: localizedPath("/about", locale), label: labels.nav.about },
  { href: localizedPath("/contact", locale), label: labels.nav.contact },
  { href: "/privacy/", label: labels.nav.privacy },
  { href: "/terms-and-conditions/", label: labels.nav.terms },
];

/** Normalize trailing slashes so "/teams", "/teams/" and "/de/teams/" all match. */
const normalize = (path: string) =>
  (path.split(/[?#]/)[0].replace(/\/+$/, "") || "/").toLowerCase();

const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) => {
  const target = normalize(href);
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
const moreActive = moreLinks.some((link) => isActive(link.href));
---

<header class="site-header">
  <div class="inner">
    <a
      href={localizedPath("/", locale)}
      class="wordmark"
      aria-label="My World Cup XI - Home"
    >
      <img src="/logo.svg" alt="" width="232" height="40" />
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {
        primaryLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <div class="more" id="nav-more">
        <button
          type="button"
          class="nav-link more-toggle"
          id="more-toggle"
          aria-expanded="false"
          aria-controls="more-menu"
          aria-current={moreActive ? "true" : undefined}
        >
          {labels.nav.more}
          <ChevronDown class="more-caret" aria-hidden="true" />
        </button>
        <div class="more-menu" id="more-menu">
          {
            moreLinks.map((link) => (
              <a
                href={link.href}
                class="nav-link"
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <LocaleSwitcher lang={locale} />
    </nav>

    <div class="actions">
      <a href="/game/" class="nav-link nav-link-cta" id="new-draft"
        >{labels.nav.newDraft}</a
      >
      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-label={labels.nav.menuToggle}
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <Menu class="icon-open" data-icon-open />
        <X class="icon-close" data-icon-close />
      </button>
    </div>
  </div>
</header>

<script>
  import { confirmAction } from "../lib/confirmDialog.js";

  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("primary-nav");
  const newDraft = document.getElementById("new-draft");
  const more = document.getElementById("nav-more");
  const moreToggle = document.getElementById("more-toggle");

  const closeMore = () => {
    more?.classList.remove("is-open");
    moreToggle?.setAttribute("aria-expanded", "false");
  };

  if (toggle && nav) {
    const close = () => {
      nav.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      closeMore();
    };
    const closeAndRefocus = () => {
      if (nav.classList.contains("is-open")) {
        close();
        toggle.focus();
      }
    };
    toggle.addEventListener("click", () => {
      const open = nav.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
      if (!open) closeMore();
    });
    nav.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeMore();
        closeAndRefocus();
      }
    });
  }

  moreToggle?.addEventListener("click", () => {
    if (!more) return;
    const open = more.classList.toggle("is-open");
    moreToggle.setAttribute("aria-expanded", String(open));
  });

  document.addEventListener("click", (e) => {
    if (more && !more.contains(e.target as Node)) closeMore();
  });

  newDraft?.addEventListener("click", async (e) => {
    e.preventDefault();
    const onGame = window.location.pathname.startsWith("/game");
    let hasSaved = false;
    try {
      hasSaved = !!window.localStorage.getItem("wc:game:v1");
    } catch {
      // Storage unavailable: no saved run to confirm.
    }
    if (hasSaved) {
      const ok = await confirmAction({
        title: "Start a new draft?",
        message: "This clears your current run.",
        confirmLabel: "Start new draft",
        danger: true,
      });
      if (!ok) return;
    }
    if (onGame) {
      window.dispatchEvent(new CustomEvent("wc:reset"));
    } else {
      try {
        window.localStorage.removeItem("wc:game:v1");
      } catch {
        // Storage unavailable: navigation still starts a fresh client.
      }
      window.location.href = "/game/";
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-slate);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 1300px;
    margin: 0 auto;
    padding: 14px 24px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    line-height: 0.9;
    letter-spacing: 1.07px;
    color: #ffffff;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    line-height: 2;
    text-transform: uppercase;
    color: #ffffff;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 20px;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: var(--color-mint);
  }

  .nav-link[aria-current="page"],
  .nav-link[aria-current="true"] {
    color: var(--color-mint);
  }

  .more {
    position: relative;
  }

  .more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .more-caret {
    width: 14px;
    height: 14px;
    transition: transform 150ms ease;
  }

  .more.is-open .more-caret {
    transform: rotate(180deg);
  }

  .more-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 60;
    min-width: 180px;
    flex-direction: column;
    gap: 2px;
    padding: 6px;
    background: var(--color-canvas);
    border: 1px solid var(--color-slate);
    border-radius: 14px;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
  }

  .more.is-open .more-menu {
    display: flex;
  }

  .more-menu .nav-link {
    text-align: left;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: 8px;
  }

  .nav-link-cta {
    color: #000000;
    background: var(--color-mint);
    white-space: nowrap;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .nav-link-cta:hover {
    background: #ffffff;
    color: #000000;
  }

  .menu-toggle {
    display: none;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-focuscyan);
    outline-offset: 2px;
  }

  @media (max-width: 959px) {
    .wordmark {
      font-size: 1.125rem;
    }

    .inner {
      padding: 12px 16px;
    }

    .actions {
      margin-left: auto;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      color: #ffffff;
      background: transparent;
      border: 1px solid var(--color-slate);
      border-radius: 10px;
      cursor: pointer;
      transition:
        color 150ms ease,
        border-color 150ms ease;
    }

    .menu-toggle:hover {
      color: var(--color-mint);
      border-color: var(--color-mint);
    }

    .icon-close {
      display: none;
    }

    .menu-toggle[aria-expanded="true"] .icon-open {
      display: none;
    }

    .menu-toggle[aria-expanded="true"] .icon-close {
      display: block;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      margin-left: 0;
      max-height: calc(100vh - 64px);
      overflow-y: auto;
      background: var(--color-canvas);
      border-bottom: 1px solid var(--color-slate);
      padding: 10px 16px 14px;
    }

    .nav.is-open {
      display: flex;
    }

    .nav-link {
      text-align: left;
      padding: 12px 10px;
      line-height: 1.4;
    }

    .more {
      display: contents;
    }

    .more-toggle {
      display: none;
    }

    .more-menu {
      display: flex;
      position: static;
      min-width: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: transparent;
    }

    .nav .locale-switcher {
      margin-left: 0;
      padding: 6px 0 0;
      border-left: none;
      width: 100%;
    }
  }
</style>
