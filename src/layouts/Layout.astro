---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locales, defaultLocale } from "../i18n/config";
import type { Locale } from "../i18n/config";
import { localizedPath, stripLocale } from "../i18n/t";

interface Props {
  title: string;
  description?: string;
  path?: string;
  lang?: Locale;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Draft a fantasy World Cup XI from 100+ historical squads (1970-2026) and run it through a simulated group stage and knockout tournament.",
  lang = defaultLocale,
  path = stripLocale(Astro.url.pathname, lang),
  ogImage = "/og-image.svg",
  noindex = false,
} = Astro.props;

const siteUrl = "https://example.com";
const canonical = localizedPath(path, lang);
const fullUrl = new URL(canonical, siteUrl).toString();
const fullImage = new URL(ogImage, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "World Cup Draft Simulator",
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      description:
        "A free browser-based fantasy football World Cup draft and tournament simulation game. Draft a dream XI from 100+ historical squads and simulate the cup.",
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "World Cup Draft Simulator",
      publisher: { "@id": `${siteUrl}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteUrl}/teams/#search`,
        "query-input": "required name=search",
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={fullUrl} />
    {locales.map((loc) => (
      <link rel="alternate" hreflang={loc} href={new URL(localizedPath(path, loc), siteUrl).toString()} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(path, defaultLocale), siteUrl).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="World Cup Draft Simulator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:locale" content={lang} />
    {locales.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  html {
    scroll-behavior: smooth;
  }
</style>